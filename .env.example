# Copy to .env. The only setting that has to be right is the node address.
VNODE_UPSTREAM_HOST=meshtastic.local
VNODE_UPSTREAM_PORT=4403

# Ports. Change these if something else on this machine already uses them.
# Under docker compose they also set the published host ports.
VNODE_LISTEN_PORT=4404
VNODE_WEB_PORT=8080

VNODE_DB_PATH=data/vnode.sqlite3
VNODE_RETENTION_DAYS=30
VNODE_LOG_LEVEL=INFO

# Let connected apps change the node's own settings (also a switch in the web UI).
VNODE_ALLOW_ADMIN=false

# Everything below is tuning; the defaults are fine.
# VNODE_REPLAY_MODE=cursor          # cursor | none
# VNODE_REPLAY_LIMIT=200
# VNODE_REPLAY_MAX_AGE_DAYS=30
# VNODE_CLIENT_KEY_MODE=ip          # ip | ip_port | shared
# VNODE_TRACE_FRAMES=false          # hex-dump every frame; very loud, and it
                                    # dumps key material - see docs/security.md
